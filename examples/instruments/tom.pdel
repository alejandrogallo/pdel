;;; tom.pdel --- simple electronic tom -*- lexical-binding: t; -*-
;; A gentler pitch sweep and longer decay than the kick.

(pd-lisp!
 (dsp-1)
 (let* ((trigger (bng! nil :label tom))
        (pitch (@vline~
                (@msg ["210 0, 125 120 0"] trigger)))
        (envelope (@vline~
                   (@msg ["1 3, 0 430 3"] trigger)))
        (voice (@*~ (@osc~ pitch) envelope)))
   (@dac~ voice (@ 1 voice))))
