;;; pd-lib-name: synth/additive-organ~
;;; pd-lib-category: synthesizer
;;; pd-lib-inlets: ((0 control trigger) (1 signal fundamental-hz))
;;; pd-lib-outlets: ((0 signal audio))

(pd-lisp!
 (let* ((trigger (@inlet))
        (frequency (@inlet~))
        (partials
         (@+~
          (@*~ [0.55] (@osc~ frequency))
          (@+~
           (@*~ [0.28] (@osc~ (@*~ [2] frequency)))
           (@+~
            (@*~ [0.12] (@osc~ (@*~ [3] frequency)))
            (@*~ [0.08] (@osc~ (@*~ [4] frequency)))))))
        (envelope (@vline~
                   (@msg ["1 8, 0 900 8"] trigger))))
   (@outlet~ (@*~ partials envelope))))
