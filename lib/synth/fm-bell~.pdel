;;; pd-lib-name: synth/fm-bell~
;;; pd-lib-category: synthesizer
;;; pd-lib-inlets: ((0 control trigger) (1 signal carrier-hz))
;;; pd-lib-outlets: ((0 signal audio))

(pd-lisp!
 (let* ((trigger (@inlet))
        (frequency (@inlet~))
        (index (@vline~
                (@msg ["850 0, 20 1500 0"] trigger)))
        (carrier
         (@osc~
          (@+~ frequency
               (@*~ (@osc~ (@*~ [1.5] frequency)) index))))
        (envelope (@vline~
                   (@msg ["1 5, 0 2200 5"] trigger))))
   (@outlet~ (@*~ carrier envelope))))
