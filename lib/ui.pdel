                         (font-size 12)
                         (background "#fcfcfc")
                         (foreground "#000000")
                         (label-color "#000000")
                         (default 0)
                         (steady-on-click 1))
  `(vsl ,(vector
          width height minimum maximum logarithmic init
          send-symbol receive-symbol label
          label-x label-y font font-size
          background foreground label-color
          default steady-on-click)
        ,input))

(defpdel-macro switch-toggle
    (&optional
     input
     &key
     (size 20)
     (init 0)
     (send-symbol 'empty)
     (receive-symbol 'empty)
     (label 'empty)
     (label-x 0)
     (label-y -10)
     (font 0)
     (font-size 12)
     (background "#fcfcfc")
     (active "#000000")
     (label-color "#000000")
     (default 0)
     (nonzero-value 1))
  `(tgl ,(vector
          size init send-symbol receive-symbol
          label label-x label-y font font-size
          background active label-color
          default nonzero-value)
        ,input))

(defpdel-macro radio-h (&optional
                        input
                        &key
                        (size 20)
                        (new-old 1)
                        (init 0)
                        (number 8)
