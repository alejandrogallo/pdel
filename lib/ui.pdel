(in-package #:pdel-user)

(defpdel-macro bng! (&optional
                     input
                     &key
                     (size 20)
                     (hold-time 250)
                     (interrupt-time 50)
                     (init 0)
                     (send-symbol 'empty)
                     (receive-symbol 'empty)
                     (label 'empty)
                     (label-x 0)
                     (label-y -10)
                     (font 0)
                     (font-size 12)
                     (background "#fcfcfc")
                     (active "#000000")
                     (label-color "#000000"))
  `(bng
    #(,size
      ,hold-time
      ,interrupt-time
      ,init send-symbol
      ,receive-symbol
      ,label
      ,label-x
      ,label-y
      ,font
      ,font-size
      ,background
      ,active
      ,label-color)
    ,input))

(defpdel-macro slider-h (&optional
                         input
                         &key
                         (width 128)
                         (height 15)
                         (minimum 0)
                         (maximum 127)
                         (logarithmic 0)
                         (init 0)
                         (send-symbol 'empty)
                         (receive-symbol 'empty)
                         (label 'empty)
                         (label-x -2)
                         (label-y -10)
                         (font 0)
                         (font-size 12)
                         (background "#fcfcfc")
                         (foreground "#000000")
                         (label-color "#000000")
                         (default 0)
                         (steady-on-click 1))
  `(hsl ,(vector
          width height minimum maximum logarithmic init
          send-symbol receive-symbol label
          label-x label-y font font-size
          background foreground label-color
          default steady-on-click)
        ,input))

(defpdel-macro slider-v (&optional
                         input
                         &key
                         (width 15)
                         (height 128)
                         (minimum 0)
                         (maximum 127)
                         (logarithmic 0)
                         (init 0)
