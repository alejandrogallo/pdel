                        (receive-symbol 'empty)
                        (label 'empty)
                        (label-x 0)
                        (label-y -10)
                        (font 0)
                        (font-size 12)
                        (background "#fcfcfc")
                        (active "#000000")
                        (label-color "#000000")
                        (default 0))
  `(tgl ,(vector
          size new-old init number
          send-symbol receive-symbol
          label label-x label-y font font-size
          background active label-color
          default)
