(defpdel-macro switch-radio-v (&optional
                               input
                               &key
                               (size 20)
                               (new-old 1)
                               (init 0)
                               (number 8)
                               (send-symbol 'empty)
                               (receive-symbol 'empty)
                               (label 'empty)
                               (label-x 0)
                               (label-y -10)
                               (font 0)
                               (font-size 12)
                               (background "#fcfcfc")
                               (active "#000000")
                               (label-color "#000000")
                               (default 0))
  `(vradio
    ,(vector
      size new-old init number
