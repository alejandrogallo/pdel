;;; pd-lib-name: poly/organ4~
;;; pd-lib-category: polyphonic
;;; pd-lib-inlets: ((0 control note-velocity-list))
;;; pd-lib-outlets: ((0 signal audio))
;;; pd-lib-note: four-voice MIDI allocator using Pd poly

(pd-lisp!
 (let* ((event (@inlet))
        (uv (@unpack [f f] event))
        (allocator (@poly [4 1] (@ 0 uv) (@ 1 uv)))
        (packet (@pack [f f f] (@ 0 allocator) (@ 1 allocator) (@ 2 allocator)))
        (router (@route [1 2 3 4] packet))
        (v1 (@pdel/voice/organ-note~ (@ 0 router)))
        (v2 (@pdel/voice/organ-note~ (@ 1 router)))
        (v3 (@pdel/voice/organ-note~ (@ 2 router)))
        (v4 (@pdel/voice/organ-note~ (@ 3 router))))
   (@outlet~ (@*~ [0.45] (@+~ v1 (@+~ v2 (@+~ v3 v4)))))))
