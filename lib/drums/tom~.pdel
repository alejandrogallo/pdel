;;; pd-lib-name: drums/tom~
;;; pd-lib-category: percussion
;;; pd-lib-inlets: ((0 control trigger))
;;; pd-lib-outlets: ((0 signal audio))

(pd-lisp!
 (let* ((trigger (@inlet))
        (pitch (@vline~
                (@msg ["210 0, 125 120 0"] trigger)))
        (envelope (@vline~
                   (@msg ["1 3, 0 430 3"] trigger))))
   (@outlet~
    (@*~ (@osc~ pitch) envelope))))
