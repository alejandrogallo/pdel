;;; pd-lib-name: drums/clap~
;;; pd-lib-category: percussion
;;; pd-lib-inlets: ((0 control trigger))
;;; pd-lib-outlets: ((0 signal audio))

(pd-lisp!
 (let* ((trigger (@inlet))
        (envelope
         (@vline~
          (@msg ["1 0, 0 18 0, 1 28 0, 0 46 0, 1 58 0, 0 170 58"]
                trigger))))
   (@outlet~
    (@*~
     (@bp~ [1400 0.8]
           (@hip~ [700] (@noise~)))
     envelope))))
