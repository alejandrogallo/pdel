;;; pd-lib-name: drums/cowbell~
;;; pd-lib-category: percussion
;;; pd-lib-inlets: ((0 control trigger))
;;; pd-lib-outlets: ((0 signal audio))

(pd-lisp!
 (let* ((trigger (@inlet))
        (metal
         (@+~
          (@clip~ [-1 1] (@*~ [8] (@osc~ [540])))
          (@clip~ [-1 1] (@*~ [8] (@osc~ [800])))))
        (envelope (@vline~
                   (@msg ["1 1, 0 260 1"] trigger))))
   (@outlet~
    (@*~ (@bp~ [1200 3] metal) envelope))))
