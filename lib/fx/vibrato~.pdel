;;; fx/vibrato~ --- converted PDEL library definition
;;; category: effect
;;; note: 5.2Hz vibrato, about +/-3ms

(defpdel fx/vibrato~ :inputs ((audio signal)) :outputs ((audio signal))
 (let*
   ((x audio) (writer (delwrite~ #($0-vibrato 80) x)) (delay-ms (+~ #(8) (*~ #(3) (osc~ #(5.2))))) (wet (vd~ #($0-vibrato) delay-ms))) (*~ #(0.9) wet)))
