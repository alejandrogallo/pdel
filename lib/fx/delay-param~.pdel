;;; fx/delay-param~ --- converted PDEL library definition
;;; category: effect

(in-package #:pdel-user)

(defpdel fx/delay-param~
    ((audio signal) (delay-ms signal) (feedback-0-to-0.9 signal))
  :outputs ((audio signal))
  (let*
      ((x audio) (time delay-ms) (feedback feedback-0-to-0.9)
       (sum (+~ x)) (writer (delwrite~ #($0-delay-param 4000) sum))
       (tap (vd~ #($0-delay-param) time)) (fb (*~ tap feedback)))
    (-> fb 0 sum 1) (+~ (*~ #(0.75) x) (*~ #(0.5) tap))))
