;;; pd-lib-name: fx/tremolo~
;;; pd-lib-category: effect
;;; pd-lib-inlets: ((0 signal input) (1 signal rate-hz))
;;; pd-lib-outlets: ((0 signal output))
;;; pd-lib-note: full-depth unipolar sine tremolo

(pd-lisp!
 (let* ((input (@inlet~))
        (rate (@inlet~))
        (lfo (@*~ [0.5]
                  (@+~ [1] (@osc~ rate)))))
   (@outlet~ (@*~ input lfo))))
