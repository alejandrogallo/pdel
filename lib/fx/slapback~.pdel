;;; pd-lib-inlets: ((0 signal audio))
;;; pd-lib-outlets: ((0 signal audio))
;;; pd-lib-note: 105ms slapback

(pd-lisp!
 (let* ((x (@inlet~)) (writer (@delwrite~ [$0-slap 400] x)) (tap (@delread~ [$0-slap 105])))
   (@outlet~ (@+~ x (@*~ [0.36] tap)))))
