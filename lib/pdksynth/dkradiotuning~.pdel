;;; pdksynth/dkradiotuning~ --- converted PDEL library definition
;;; category: pdksynth-effect
;;; note: radio-tuning coloration corresponding to upstream dkradiotuning~

(defpdel pdksynth/dkradiotuning~ ((audio signal) (tuning-0-to-1 signal)) :outputs ((audio signal))
 (let*
   ((x audio) (tune tuning-0-to-1) (mod (*~ #(35) (osc~ (+~ #(0.25) (*~ #(5) tune))))) (y (bp~ #(0 2.2) x (+~ #(1200) (*~ #(2400) tune))))) (clip~ #(-1 1) (+~ y (*~ #(0.08) mod)))))
