;;; pd-lib-name: pdksynth/dkbd3~
;;; pd-lib-category: pdksynth-percussion
;;; pd-lib-inlets: ((0 control trigger))
;;; pd-lib-outlets: ((0 signal audio))
;;; pd-lib-note: noise-enhanced bass drum corresponding to upstream dkbd3~
;;; Upstream: https://github.com/derekxkwan/pdksynth
;;; License: GPL-3.0-or-later (derived port namespace)
(pd-lisp!
 (let* ((t (@inlet))
        (p (@vline~ (@msg ["130 0, 44 110 0"] t)))
        (e (@vline~ (@msg ["1 2, 0 420 2"] t)))
        (n (@*~ (@vline~ (@msg ["1 0, 0 35 0"] t)) (@lop~ [900] (@noise~)))))
   (@outlet~ (@+~ (@*~ e (@osc~ p)) (@*~ [0.16] n)))))
