;;; pdksynth/dkbd2~ --- converted PDEL library definition
;;; category: pdksynth-percussion
;;; note: 808-ish bass drum voice corresponding to upstream dkbd2~

(in-package #:pdel-user)

(defpdel pdksynth/dkbd2~ ((trigger control)) :outputs ((audio signal))
 (let*
   ((t trigger) (p (vline~ (msg #("180 0, 46 180 0") t)))
    (e (vline~ (msg #("1 1, 0.65 80 1, 0 650 81") t)))
    (click
      (*~ (vline~ (msg #("1 0, 0 8 0") t)) (hip~ #(1800) (noise~)))))
   (+~ (*~ e (osc~ p)) (*~ #(0.12) click))))
