;;; pdksynth/dksd2~ --- converted PDEL library definition
;;; category: pdksynth-percussion
;;; note: snare synthesizer corresponding to upstream dksd2~

(in-package #:pdel-user)

(defpdel pdksynth/dksd2~ ((trigger control)) :outputs ((audio signal))
 (let*
   ((t trigger) (e (vline~ (msg #("1 1, 0 260 1") t)))
    (tone (*~ #(0.45) (osc~ #(200))))
    (noise (*~ #(0.8) (bp~ #(3300 1.2) (noise~)))))
   (*~ e (+~ tone noise))))
