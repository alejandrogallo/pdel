;;; pd-lib-name: pdksynth/dkradiostatic~
;;; pd-lib-category: pdksynth-effect
;;; pd-lib-inlets: ((0 signal audio) (1 signal amount-0-to-1))
;;; pd-lib-outlets: ((0 signal audio))
;;; pd-lib-note: radio-static effect corresponding to upstream dkradiostatic~
