;;; pdksynth/dkradiostatic~ --- converted PDEL library definition
;;; category: pdksynth-effect
;;; note: radio-static effect corresponding to upstream dkradiostatic~

(in-package #:pdel-user)

(defpdel pdksynth/dkradiostatic~
    ((audio signal) (amount-0-to-1 signal)) :outputs ((audio signal))
 (let* ((x audio) (a amount-0-to-1) (n (bp~ #(4200 0.8) (noise~))))
   (+~ (*~ x (-~ #(1) a)) (*~ a n))))
