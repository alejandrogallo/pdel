;;; pd-lib-name: pdksynth/dkclap~
;;; pd-lib-category: pdksynth-percussion
;;; pd-lib-inlets: ((0 control trigger))
;;; pd-lib-outlets: ((0 signal audio))
;;; pd-lib-note: clap synthesizer corresponding to upstream dkclap~
;;; Upstream: https://github.com/derekxkwan/pdksynth
;;; License: GPL-3.0-or-later (derived port namespace)
(pd-lisp!
 (let* ((t (@inlet))
        (e (@vline~ (@msg ["1 0, 0 18 0, 1 22 22, 0 18 44, 1 22 66, 0 18 88, 0.45 35 120, 0 220 155"] t))))
   (@outlet~ (@*~ e (@bp~ [1500 0.9] (@hip~ [700] (@noise~)))))))
