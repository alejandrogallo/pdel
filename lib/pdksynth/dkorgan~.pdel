;;; pdksynth/dkorgan~ --- converted PDEL library definition
;;; category: pdksynth-pitched
;;; note: additive organ corresponding to upstream dkorgan~

(defpdel pdksynth/dkorgan~ ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((t trigger) (f frequency-hz) (e (vline~ (msg #("1 15, 0.9 100 15, 0 900 115") t)))
     (v
       (+~ (osc~ f)
         (+~ (*~ #(0.55) (osc~ (*~ #(2) f))) (+~ (*~ #(0.3) (osc~ (*~ #(3) f))) (*~ #(0.18) (osc~ (*~ #(4) f)))))))) (*~ #(0.42) e v)))
