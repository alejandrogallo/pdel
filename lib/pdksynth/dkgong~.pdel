;;; pdksynth/dkgong~ --- converted PDEL library definition
;;; category: pdksynth-percussion
;;; note: FM gong voice corresponding to upstream dkgong~

(defpdel pdksynth/dkgong~ :inputs ((trigger control)) :outputs ((audio signal))
 (let*
   ((t trigger) (e (vline~ (msg #("1 3, 0 2800 3") t))) (m1 (osc~ #(83))) (m2 (osc~ #(131))) (c (osc~ (+~ #(220) (+~ (*~ #(45) m1) (*~ #(23) m2)))))) (*~ e c)))
