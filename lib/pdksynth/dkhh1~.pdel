(defpdel pdksynth/dkhh1~ :inputs ((trigger control)) :outputs ((audio signal))
 (let* ((t trigger) (e (vline~ (msg #("1 1, 0 90 1") t)))) (*~ e (bp~ #(9500 1.8) (hip~ #(6000) (noise~))))))
