;;; pdksynth/dkpiano~ --- converted PDEL library definition
;;; category: pdksynth-pitched
;;; note: piano-like additive/decay synth corresponding to upstream dkpiano~

(in-package #:pdel-user)

(defpdel pdksynth/dkpiano~ ((trigger control) (frequency-hz signal))
  :outputs ((audio signal))
 (let*
   ((t trigger) (f frequency-hz) (e (env/piano~ t))
     (v
       (+~ (osc~ f)
           (+~ (*~ #(0.34) (osc~ (*~ #(2.01) f)))
               (*~ #(0.15) (osc~ (*~ #(3.02) f)))))))
   (*~ #(0.72) e v)))
