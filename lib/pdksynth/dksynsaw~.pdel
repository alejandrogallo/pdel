(pd-lisp!
 (let* ((t (@inlet)) (f (@inlet~)) (e (@vline~ (@msg ["1 8, 0.72 250 8, 0 850 258"] t))))
   (@outlet~ (@*~ [0.5] e (@lop~ [5000] (@pdel/osc/saw~ f))))))
