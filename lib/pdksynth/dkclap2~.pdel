;;; pd-lib-name: pdksynth/dkclap2~
;;; pd-lib-category: pdksynth-percussion
;;; pd-lib-inlets: ((0 control trigger))
;;; pd-lib-outlets: ((0 signal audio))
;;; pd-lib-note: second clap synthesizer corresponding to upstream dkclap2~
;;; Upstream: https://github.com/derekxkwan/pdksynth
;;; License: GPL-3.0-or-later (derived port namespace)
(pd-lisp!
 (let* ((t (@inlet))
        (e (@vline~ (@msg ["1 0, 0 12 0, 0.9 28 18, 0 13 46, 0.8 28 62, 0 180 90"] t))))
   (@outlet~ (@*~ e (@bp~ [2100 1.1] (@noise~))))))
