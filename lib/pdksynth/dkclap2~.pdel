;;; pdksynth/dkclap2~ --- converted PDEL library definition
;;; category: pdksynth-percussion
;;; note: second clap synthesizer corresponding to upstream dkclap2~

(defpdel pdksynth/dkclap2~ ((trigger control)) :outputs ((audio signal))
 (let*
   ((t trigger) (e (vline~ (msg #("1 0, 0 12 0, 0.9 28 18, 0 13 46, 0.8 28 62, 0 180 90") t)))) (*~ e (bp~ #(2100 1.1) (noise~)))))
