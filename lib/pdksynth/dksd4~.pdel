;;; pdksynth/dksd4~ --- converted PDEL library definition
;;; category: pdksynth-percussion
;;; note: snare synthesizer corresponding to upstream dksd4~

(defpdel pdksynth/dksd4~ ((trigger control)) :outputs ((audio signal))
 (let*
   ((t trigger) (e (vline~ (msg #("1 1, 0 260 1") t))) (tone (*~ #(0.45) (osc~ #(220)))) (noise (*~ #(0.8) (bp~ #(1900 1.2) (noise~))))) (*~ e (+~ tone noise))))
