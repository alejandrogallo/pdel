;;; pd-lib-name: osc/organ~
;;; pd-lib-category: oscillator
;;; pd-lib-inlets: ((0 signal frequency-hz))
;;; pd-lib-outlets: ((0 signal audio))

(pd-lisp!
 (let* ((f (@inlet~))
        (h1 (@osc~ f))
        (h2 (@*~ [0.5] (@osc~ (@*~ [2] f))))
        (h3 (@*~ [0.25] (@osc~ (@*~ [3] f))))
        (h4 (@*~ [0.12] (@osc~ (@*~ [4] f)))))
   (@outlet~ (@*~ [0.52] (@+~ h1 (@+~ h2 (@+~ h3 h4)))))))
