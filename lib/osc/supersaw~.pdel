;;; pd-lib-name: osc/supersaw~
;;; pd-lib-category: oscillator
;;; pd-lib-inlets: ((0 signal frequency-hz))
;;; pd-lib-outlets: ((0 signal audio))
;;; pd-lib-note: three detuned saws

(pd-lisp!
 (let* ((f (@inlet~))
        (a (@pdel/osc/saw~ (@*~ [0.993] f)))
        (b (@pdel/osc/saw~ f))
        (c (@pdel/osc/saw~ (@*~ [1.007] f))))
   (@outlet~ (@*~ [0.28] (@+~ a (@+~ b c))))))
