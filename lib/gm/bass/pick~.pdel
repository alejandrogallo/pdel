;;; gm/bass/pick~ --- converted PDEL library definition
;;; category: general-midi
(in-package #:pdel-user)

(defpdel gm/bass/pick~ ((trigger control) (frequency-hz signal))
  :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pluck~ trigger))
    (voice (lop~ #(3000) (osc/saw~ frequency))))
   (*~ voice env)))
