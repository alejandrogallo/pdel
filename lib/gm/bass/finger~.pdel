;;; gm/bass/finger~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/bass/finger~ :inputs ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pluck~ trigger)) (voice (lop~ #(2400) (osc/triangle~ frequency)))) (*~ voice env)))
