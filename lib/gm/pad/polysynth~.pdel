;;; gm/pad/polysynth~ --- converted PDEL library definition
;;; category: general-midi

(in-package #:pdel-user)

(defpdel gm/pad/polysynth~ ((trigger control) (frequency-hz signal))
  :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pad~ trigger))
    (voice
      (lop~ #(4200)
            (+~ (osc/saw~ frequency) (osc/square-soft~ frequency)))))
   (*~ voice env)))
