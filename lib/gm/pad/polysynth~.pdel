;;; gm/pad/polysynth~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/pad/polysynth~ :inputs ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pad~ trigger)) (voice (lop~ #(4200) (+~ (osc/saw~ frequency) (osc/square-soft~ frequency))))) (*~ voice env)))
