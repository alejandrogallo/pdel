;;; gm/pad/atmosphere~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/pad/atmosphere~ :inputs ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pad~ trigger)) (voice (lop~ #(5000) (+~ (osc/supersaw~ frequency) (*~ #(0.08) (noise~)))))) (*~ voice env)))
