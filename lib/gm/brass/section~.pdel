;;; gm/brass/section~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/brass/section~ :inputs ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/brass~ trigger)) (voice (lop~ #(4800) (osc/supersaw~ frequency)))) (*~ voice env)))
