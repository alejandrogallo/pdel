;;; gm/brass/trumpet~ --- converted PDEL library definition
;;; category: general-midi

(in-package #:pdel-user)

(defpdel gm/brass/trumpet~ ((trigger control) (frequency-hz signal))
  :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/brass~ trigger))
    (voice (bp~ #(1800 0.9) (osc/saw~ frequency))))
   (*~ voice env)))
