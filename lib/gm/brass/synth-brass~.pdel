;;; gm/brass/synth-brass~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/brass/synth-brass~ :inputs ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/brass~ trigger)) (voice (lop~ #(3600) (osc/square-soft~ frequency)))) (*~ voice env)))
