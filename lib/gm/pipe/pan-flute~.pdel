;;; gm/pipe/pan-flute~ --- converted PDEL library definition
;;; category: general-midi

(in-package #:pdel-user)

(defpdel gm/pipe/pan-flute~ ((trigger control) (frequency-hz signal))
  :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/string~ trigger))
    (voice (lop~ #(5200) (+~ (osc~ frequency) (*~ #(0.06) (noise~))))))
   (*~ voice env)))
