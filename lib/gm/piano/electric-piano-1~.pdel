;;; gm/piano/electric-piano-1~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/piano/electric-piano-1~ ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/mallet~ trigger))
     (voice
       (+~ (osc~ frequency) (*~ #(0.35) (osc~ (+~ frequency (*~ #(55) (osc~ (*~ #(2) frequency))))))))) (*~ voice env)))
