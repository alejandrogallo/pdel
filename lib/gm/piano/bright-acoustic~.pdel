;;; gm/piano/bright-acoustic~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/piano/bright-acoustic~ :inputs ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/piano~ trigger)) (voice (hip~ #(120) (+~ (osc~ frequency) (*~ #(0.48) (osc~ (*~ #(3) frequency))))))) (*~ voice env)))
