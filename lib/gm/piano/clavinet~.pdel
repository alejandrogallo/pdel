;;; gm/piano/clavinet~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/piano/clavinet~ :inputs ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pluck~ trigger)) (voice (bp~ #(1800 1.2) (osc/square-soft~ frequency)))) (*~ voice env)))
