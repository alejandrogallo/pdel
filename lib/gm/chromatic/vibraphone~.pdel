;;; gm/chromatic/vibraphone~ --- converted PDEL library definition
;;; category: general-midi

(in-package #:pdel-user)

(defpdel gm/chromatic/vibraphone~
    ((trigger control) (frequency-hz signal)) :outputs
  ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/long-perc~ trigger))
     (voice
       (lop~ #(6500)
             (+~ (osc~ frequency)
                 (*~ #(0.45) (osc~ (*~ #(2.0) frequency)))))))
   (*~ voice env)))
