;;; gm/chromatic/music-box~ --- converted PDEL library definition
;;; category: general-midi

(in-package #:pdel-user)

(defpdel gm/chromatic/music-box~
    ((trigger control) (frequency-hz signal)) :outputs
  ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/mallet~ trigger))
     (voice
       (bp~ #(4200 1.2)
            (+~ (osc~ frequency)
                (*~ #(0.45) (osc~ (*~ #(2.01) frequency)))))))
   (*~ voice env)))
