;;; pd-lib-name: gm/chromatic/tubular-bells~
;;; pd-lib-category: general-midi
;;; pd-lib-inlets: ((0 control trigger) (1 signal frequency-hz))
;;; pd-lib-outlets: ((0 signal audio))

(pd-lisp!
 (let* ((trigger (@inlet)) (frequency (@inlet~))
        (env (@pdel/env/long-perc~ trigger))
        (voice (@bp~ [2400 1.5] (@+~ (@osc~ frequency) (@*~ [0.45] (@osc~ (@*~ [2.41] frequency)))))))
   (@outlet~ (@*~ voice env))))
