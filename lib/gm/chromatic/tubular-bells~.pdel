;;; gm/chromatic/tubular-bells~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/chromatic/tubular-bells~ ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/long-perc~ trigger))
     (voice
       (bp~ #(2400 1.5) (+~ (osc~ frequency) (*~ #(0.45) (osc~ (*~ #(2.41) frequency))))))) (*~ voice env)))
