;;; gm/organ/percussive~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/organ/percussive~ ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/long-perc~ trigger)) (voice (+~ (osc/organ~ frequency) (*~ #(0.2) (osc~ (*~ #(3) frequency)))))) (*~ voice env)))
