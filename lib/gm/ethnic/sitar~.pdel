;;; gm/ethnic/sitar~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/ethnic/sitar~ ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pluck~ trigger))
     (voice
       (bp~ #(2500 1.3) (+~ (osc/saw~ frequency) (*~ #(0.2) (osc~ (*~ #(2.01) frequency))))))) (*~ voice env)))
