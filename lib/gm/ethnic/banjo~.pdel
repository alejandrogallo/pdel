;;; gm/ethnic/banjo~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/ethnic/banjo~ :inputs ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pluck~ trigger)) (voice (bp~ #(1800 0.9) (osc/square-soft~ frequency)))) (*~ voice env)))
