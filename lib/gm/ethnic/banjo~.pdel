;;; gm/ethnic/banjo~ --- converted PDEL library definition
;;; category: general-midi

(in-package #:pdel-user)

(defpdel gm/ethnic/banjo~ ((trigger control) (frequency-hz signal))
  :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pluck~ trigger))
    (voice (bp~ #(1800 0.9) (osc/square-soft~ frequency))))
   (*~ voice env)))
