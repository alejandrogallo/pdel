;;; pd-lib-name: gm/ethnic/banjo~
;;; pd-lib-category: general-midi
;;; pd-lib-inlets: ((0 control trigger) (1 signal frequency-hz))
;;; pd-lib-outlets: ((0 signal audio))

(pd-lisp!
 (let* ((trigger (@inlet)) (frequency (@inlet~))
        (env (@pdel/env/pluck~ trigger))
        (voice (@bp~ [1800 0.9] (@pdel/osc/square-soft~ frequency))))
   (@outlet~ (@*~ voice env))))
