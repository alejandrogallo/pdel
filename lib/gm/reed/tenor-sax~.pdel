;;; gm/reed/tenor-sax~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/reed/tenor-sax~ ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/brass~ trigger)) (voice (bp~ #(950 1.0) (osc/saw~ frequency)))) (*~ voice env)))
