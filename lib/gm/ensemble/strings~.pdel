;;; gm/ensemble/strings~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/ensemble/strings~ ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pad~ trigger)) (voice (lop~ #(6500) (osc/supersaw~ frequency)))) (*~ voice env)))
