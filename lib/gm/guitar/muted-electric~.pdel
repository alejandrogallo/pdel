;;; gm/guitar/muted-electric~ --- converted PDEL library definition
;;; category: general-midi

(in-package #:pdel-user)

(defpdel gm/guitar/muted-electric~
    ((trigger control) (frequency-hz signal)) :outputs
  ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/fast-perc~ trigger))
    (voice (lop~ #(3600) (osc/square-soft~ frequency))))
   (*~ voice env)))
