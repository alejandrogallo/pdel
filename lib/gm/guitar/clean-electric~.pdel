;;; gm/guitar/clean-electric~ --- converted PDEL library definition
;;; category: general-midi

(in-package #:pdel-user)

(defpdel gm/guitar/clean-electric~
    ((trigger control) (frequency-hz signal)) :outputs
  ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pluck~ trigger))
    (voice (lop~ #(6500) (osc/triangle~ frequency))))
   (*~ voice env)))
