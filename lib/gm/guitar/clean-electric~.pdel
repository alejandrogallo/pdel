;;; gm/guitar/clean-electric~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/guitar/clean-electric~ :inputs ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pluck~ trigger)) (voice (lop~ #(6500) (osc/triangle~ frequency)))) (*~ voice env)))
