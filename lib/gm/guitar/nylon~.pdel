;;; gm/guitar/nylon~ --- converted PDEL library definition
;;; category: general-midi

(in-package #:pdel-user)

(defpdel gm/guitar/nylon~ ((trigger control) (frequency-hz signal))
  :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pluck~ trigger))
    (voice
      (lop~ #(5200)
            (+~ (osc/triangle~ frequency) (*~ #(0.18) (noise~))))))
   (*~ voice env)))
