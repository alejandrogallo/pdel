;;; gm/lead/fifths~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/lead/fifths~ ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/long-perc~ trigger)) (voice (+~ (osc/saw~ frequency) (*~ #(0.5) (osc/saw~ (*~ #(1.5) frequency)))))) (*~ voice env)))
