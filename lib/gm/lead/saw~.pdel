;;; gm/lead/saw~ --- converted PDEL library definition
;;; category: general-midi

(in-package #:pdel-user)

(defpdel gm/lead/saw~ ((trigger control) (frequency-hz signal))
  :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/long-perc~ trigger))
    (voice (lop~ #(6200) (osc/saw~ frequency))))
   (*~ voice env)))
