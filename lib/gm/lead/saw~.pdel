;;; gm/lead/saw~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/lead/saw~ :inputs ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/long-perc~ trigger)) (voice (lop~ #(6200) (osc/saw~ frequency)))) (*~ voice env)))
