;;; gm/strings/pizzicato~ --- converted PDEL library definition
;;; category: general-midi

(defpdel gm/strings/pizzicato~ :inputs ((trigger control) (frequency-hz signal)) :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/pluck~ trigger)) (voice (lop~ #(5000) (osc/triangle~ frequency)))) (*~ voice env)))
