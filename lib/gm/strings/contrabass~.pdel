;;; gm/strings/contrabass~ --- converted PDEL library definition
;;; category: general-midi

(in-package #:pdel-user)

(defpdel gm/strings/contrabass~
    ((trigger control) (frequency-hz signal)) :outputs
  ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/string~ trigger))
    (voice (lop~ #(2200) (osc/saw~ frequency))))
   (*~ voice env)))
