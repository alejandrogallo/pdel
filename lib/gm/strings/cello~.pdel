;;; gm/strings/cello~ --- converted PDEL library definition
;;; category: general-midi

(in-package #:pdel-user)

(defpdel gm/strings/cello~ ((trigger control) (frequency-hz signal))
  :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/string~ trigger))
    (voice (lop~ #(3600) (osc/saw~ frequency))))
   (*~ voice env)))
