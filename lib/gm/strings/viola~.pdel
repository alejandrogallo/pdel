;;; gm/strings/viola~ --- converted PDEL library definition
;;; category: general-midi

(in-package #:pdel-user)

(defpdel gm/strings/viola~ ((trigger control) (frequency-hz signal))
  :outputs ((audio signal))
 (let*
   ((frequency frequency-hz) (env (env/string~ trigger))
    (voice (lop~ #(5200) (osc/saw~ frequency))))
   (*~ voice env)))
