;;; voice/piano-note~ --- converted PDEL library definition
;;; category: voice

(defpdel voice/piano-note~ ((note-velocity-list control)) :outputs ((audio signal))
 (let*
   ((event note-velocity-list) (uv (unpack #(f f) event)) (note (out 0 uv)) (velocity (out 1 uv)) (frequency (mtof note)) (gate (moses #(1) velocity)) (trigger (out 1 gate)) (env (env/piano~ trigger)) (amp (/ #(127) velocity)) (tone (+~ (osc~ frequency) (*~ #(0.32) (osc~ (*~ #(2.01) frequency)))))) (*~ amp (*~ tone env))))
